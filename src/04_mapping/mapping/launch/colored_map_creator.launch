<launch>
    <node pkg="mapping" type="colored_map_creator_node" name="colored_map_creator" output="screen">

        <!-- ─────────────────────────────────────────── -->
        <!-- I/O                                          -->
        <!-- ─────────────────────────────────────────── -->
        <param name="bag_path" value="$(env HOME)/bag_file/2026-07-23-12-59-57.bag" />
        <param name="save_dir" value="$(find mapping)/pcd" />

        <!-- ─────────────────────────────────────────── -->
        <!-- Topics & Preprocessing                       -->
        <!-- ─────────────────────────────────────────── -->
        <param name="lidar_topic" value="/velodyne_points" />
        <param name="image_topic" value="/image_jpeg/compressed" />
        <param name="use_color" value="true" />

        <!-- CropBox filtering configuration -->
        <param name="use_cropping"   value="true" />
        <param name="crop_min_x"    value="0.5" />
        <param name="crop_max_x"    value="100.0" />
        <param name="crop_min_y"    value="-100.0" />
        <param name="crop_max_y"    value="100.0" />
        <param name="crop_min_z"    value="-20.0" />
        <param name="crop_max_z"    value="100.0" />
        <param name="crop_negative" value="false" />

        <!-- ─────────────────────────────────────────── -->
        <!-- TF Frames                                    -->
        <!-- ─────────────────────────────────────────── -->
        <param name="map_frame"      value="map" />
        <param name="velodyne_frame" value="velodyne" />
        <param name="camera_frame"   value="Camera" />

        <!-- ─────────────────────────────────────────── -->
        <!-- Camera Intrinsics                            -->
        <!-- ─────────────────────────────────────────── -->
        <param name="fx" value="320.0" />
        <param name="fy" value="320.0" />
        <param name="cx" value="320.0" />
        <param name="cy" value="240.0" />

        <!-- Distortion coefficients [k1, k2, p1, p2, k3] -->
        <param name="k1" value="0.0" />
        <param name="k2" value="0.0" />
        <param name="p1" value="0.0" />
        <param name="p2" value="0.0" />
        <param name="k3" value="0.0" />

        <!-- ─────────────────────────────────────────── -->
        <!-- Voxel Grid                                   -->
        <!-- ─────────────────────────────────────────── -->
        <!-- Local: pre-filter each incoming scan (larger = faster, lower resolution) -->
        <param name="voxel_size_local"  value="0.3" />
        <!-- Global: final output PCD resolution (smaller = denser map) -->
        <param name="voxel_size_global" value="0.1" />

        <!-- ─────────────────────────────────────────── -->
        <!-- FastGICP Registration                        -->
        <!-- ─────────────────────────────────────────── -->
        <!-- Number of OpenMP threads for GICP (i9-12900H: 20 cores, leave 4 for system) -->
        <param name="gicp_threads"       value="16" />
        <!-- Number of nearest neighbors for covariance estimation -->
        <param name="gicp_neighbors"     value="10" />
        <!-- Max correspondence distance (m). Increase if TF drift is large -->
        <param name="gicp_max_dist"      value="1.0" />
        <!-- Convergence threshold. Smaller = more precise but slower -->
        <param name="gicp_epsilon"       value="0.01" />
        <!-- Min global map size (pts) before GICP kicks in. Trust TF until then -->
        <param name="gicp_min_map_size"  value="1000" />
        <!-- Use GICP for scan refinement (true) or trust TF only (false, extremely fast) -->
        <param name="use_gicp"           value="false" />

        <!-- ─────────────────────────────────────────── -->
        <!-- Synchronization & Logging                   -->
        <!-- ─────────────────────────────────────────── -->
        <!-- Max time gap (s) between LiDAR frame and closest image -->
        <param name="time_sync_threshold" value="0.03" />
        <!-- Print progress every N frames -->
        <param name="log_interval"        value="50" />

    </node>
</launch>
