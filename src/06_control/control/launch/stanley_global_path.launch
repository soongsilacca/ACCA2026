<launch>
  <!-- ================================================================
       Stanley Global Path Controller Launch File
       Subscribes : /global_path  (nav_msgs/Path)
                    /localization/kinematic_state  (nav_msgs/Odometry)
       Publishes  : /cmd  (morai_msgs/CtrlCmd)
  ================================================================ -->

  <arg name="use_sim_time" default="true" />
  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <rosparam file="$(find localization)/config/car.yaml" command="load" />

  <node pkg="control"
        type="stanley_global_path_node.py"
        name="stanley_global_path"
        output="screen">
    <rosparam file="$(find control)/config/stanley_params.yaml" command="load" />
    <param name="target_speed" value="8.0" />
  </node>

</launch>
