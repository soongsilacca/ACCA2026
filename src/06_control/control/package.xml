<?xml version="1.0"?>
<package format="2">
  <name>control</name>
  <version>0.0.0</version>
  <description>Stanley lateral controller that subscribes /global_path and publishes /cmd</description>

  <maintainer email="jinju@todo.todo">jinju</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>morai_msgs</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
  <depend>python3-numpy</depend>

  <export></export>
</package>
