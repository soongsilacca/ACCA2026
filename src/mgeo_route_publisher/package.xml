<?xml version="1.0"?>
<package format="2">
  <name>mgeo_route_publisher</name>
  <version>0.1.0</version>
  <description>Publishes an ego-local route and nearby MGeo tokens for multimodal learning.</description>
  <maintainer email="jinju@todo.todo">jinju</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>map_viz</exec_depend>
  <exec_depend>global_path_planner</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <export/>
</package>
