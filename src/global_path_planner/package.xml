<?xml version="1.0"?>
<package format="2">
  <name>global_path_planner</name>
  <version>0.0.0</version>
  <description>Global Path Planner using MGeo Map data and RViz start/goal pose inputs</description>

  <maintainer email="jinju@todo.todo">jinju</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export></export>
</package>
