<?xml version="1.0" encoding="UTF-8"?>
<robot name="indy7_robotiq">
  <!-- Planning Groups -->
  <group name="arm">
    <chain base_link="link0" tip_link="tcp"/>
  </group>
  
  <group name="gripper">
    <joint name="finger_joint"/>
    <joint name="left_inner_knuckle_joint"/>
    <joint name="left_inner_finger_joint"/>
    <joint name="right_outer_knuckle_joint"/>
    <joint name="right_inner_knuckle_joint"/>
    <joint name="right_inner_finger_joint"/>
  </group>


  <!-- End Effector -->
  <end_effector name="gripper" parent_link="tcp" group="gripper"/>

  <!-- Virtual Joint (for planning in world frame) -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="link0"/>

  <!-- Disable Collision Checking -->
  <disable_collisions link1="link0" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="tcp" reason="Adjacent"/>
  
  <!-- Disable collision between arm and gripper -->
  <disable_collisions link1="link6" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="tcp" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="link6" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="link6" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="link6" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="link6" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="link6" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="link6" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="link6" link2="right_inner_finger" reason="Never"/>
  
  <!-- Disable gripper self-collisions -->
  <disable_collisions link1="robotiq_85_base_link" link2="left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="left_outer_finger" reason="Adjacent"/>
  <disable_collisions link1="right_outer_knuckle" link2="right_outer_finger" reason="Adjacent"/>
  <disable_collisions link1="left_outer_knuckle" link2="left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="right_outer_knuckle" link2="right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="left_inner_knuckle" link2="left_inner_finger" reason="Adjacent"/>
  <disable_collisions link1="right_inner_knuckle" link2="right_inner_finger" reason="Adjacent"/>
  
  <!-- Disable cross-side gripper collisions -->
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="right_inner_finger" reason="Never"/>
  
  
  <!-- Disable collisions between mimic joint fingers -->
  <disable_collisions link1="left_outer_finger" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="right_inner_finger" link2="right_outer_knuckle" reason="Never"/>
  
  <!-- Disable collisions between fingers and base -->
  <disable_collisions link1="robotiq_85_base_link" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="right_inner_finger" reason="Never"/>
  
  <!-- Disable collisions between tcp and gripper -->
  <disable_collisions link1="tcp" link2="left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="tcp" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="tcp" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="tcp" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="tcp" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="tcp" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="tcp" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="tcp" link2="right_inner_finger" reason="Never"/>
  
  <!-- Disable collisions between left and right side -->
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="right_inner_finger" reason="Never"/>

  <!-- Cross collisions -->
  <disable_collisions link1="left_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="right_outer_knuckle" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="right_outer_knuckle" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="right_outer_knuckle" link2="left_inner_finger" reason="Never"/>

  <disable_collisions link1="left_inner_knuckle" link2="right_outer_finger" reason="Never"/>
  <disable_collisions link1="right_inner_knuckle" link2="left_outer_finger" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="right_inner_knuckle" link2="left_inner_finger" reason="Never"/>

  <disable_collisions link1="left_outer_finger" link2="right_inner_finger" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="left_inner_finger" reason="Never"/>

  <!-- Self side collisions -->
  <disable_collisions link1="left_outer_knuckle" link2="left_inner_knuckle" reason="Never"/> 
  <disable_collisions link1="right_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_finger" link2="left_inner_finger" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_finger" reason="Never"/>
  
  <disable_collisions link1="left_outer_finger" link2="left_inner_knuckle" reason="Never"/>
  <disable_collisions link1="right_outer_finger" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_inner_finger" link2="left_outer_knuckle" reason="Never"/>
  <disable_collisions link1="right_inner_finger" link2="right_outer_knuckle" reason="Never"/>

  <!-- Group States -->
  <group_state name="home" group="arm">
    <joint name="joint0" value="0"/>
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
  </group_state>
  
  <group_state name="open" group="gripper">
    <joint name="finger_joint" value="0"/>
    <joint name="left_inner_knuckle_joint" value="0"/>
    <joint name="left_inner_finger_joint" value="0"/>
    <joint name="right_outer_knuckle_joint" value="0"/>
    <joint name="right_inner_knuckle_joint" value="0"/>
    <joint name="right_inner_finger_joint" value="0"/>
  </group_state>
  
  <group_state name="close" group="gripper">
    <joint name="finger_joint" value="0.725"/>
    <joint name="left_inner_knuckle_joint" value="0.725"/>
    <joint name="left_inner_finger_joint" value="-0.725"/>
    <joint name="right_outer_knuckle_joint" value="-0.725"/>
    <joint name="right_inner_knuckle_joint" value="-0.725"/>
    <joint name="right_inner_finger_joint" value="0.725"/>
  </group_state>
</robot>

