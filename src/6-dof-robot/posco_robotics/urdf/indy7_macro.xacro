    <inertial>
      <mass value="0.38254932"/>
      <origin rpy="0 0 0" xyz="8.147e-05                             -0.00046556                             0.03079097"/>
      <inertia ixx="0.00078982" ixy="-3.4e-07" ixz="8.3e-07" iyy="0.00079764" iyz="-5.08e-06" izz="0.00058319"/>
    </inertial>
  </link>
  <link name="${prefix}tcp"/>
  <joint name="${prefix}global" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="world"/>
    <child link="${prefix}link0"/>
  </joint>
  <joint name="${prefix}joint0" type="revolute">
    <parent link="${prefix}link0"/>
    <child link="${prefix}link1"/>
    <origin rpy="0                         0                         0" xyz="0                          0                          0.0775"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="431.97" lower="-3.0543261909900767" upper="3.0543261909900767" velocity="2.6179938779914944"/>
  </joint>
  <joint name="${prefix}joint1" type="revolute">
    <parent link="${prefix}link1"/>
    <child link="${prefix}link2"/>
    <origin rpy="1.570796327                         1.570796327                         0" xyz="0                          -0.109                          0.222"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="10.0"/>
    <limit effort="431.97" lower="-3.0543261909900767" upper="3.0543261909900767" velocity="2.6179938779914944"/>
  </joint>
  <joint name="${prefix}joint2" type="revolute">
    <parent link="${prefix}link2"/>
    <child link="${prefix}link3"/>
    <origin rpy="0                         0                         0" xyz="-0.45                          0                          -0.0305"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="10.0"/>
    <limit effort="197.23" lower="-3.0543261909900767" upper="3.0543261909900767" velocity="2.6179938779914944"/>
  </joint>
  <joint name="${prefix}joint3" type="revolute">
    <parent link="${prefix}link3"/>
    <child link="${prefix}link4"/>
    <origin rpy="-1.570796327                         0                         1.570796327" xyz="-0.267                          0                          -0.075"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="10.0"/>
    <limit effort="79.79" lower="-3.0543261909900767" upper="3.0543261909900767" velocity="3.141592653589793"/>
  </joint>
  <joint name="${prefix}joint4" type="revolute">
    <parent link="${prefix}link4"/>
    <child link="${prefix}link5"/>
    <origin rpy="1.570796327                         1.570796327                         0" xyz="0                          -0.114                          0.083"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="10.0"/>
    <limit effort="79.79" lower="-3.0543261909900767" upper="3.0543261909900767" velocity="3.141592653589793"/>
  </joint>
  <joint name="${prefix}joint5" type="revolute">
    <parent link="${prefix}link5"/>
    <child link="${prefix}link6"/>
    <origin rpy="-1.570796327                         0                         1.570796327" xyz="-0.168                          0                          0.069"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="10.0"/>
    <limit effort="79.79" lower="-3.7524578917878086" upper="3.7524578917878086" velocity="3.141592653589793"/>
  </joint>
  <joint name="${prefix}tcp" type="fixed">
    <parent link="${prefix}link6"/>
    <child link="${prefix}tcp"/>
    <origin rpy="0.0                         0.0                         0.0" xyz="0.0                          0.0                          0.06"/>
  </joint>

  <ros2_control name="indy" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="${prefix}joint0">
      <command_interface name="position">
        <param name="min">{-2*pi}</param>
        <param name="max">{2*pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}joint1">
      <command_interface name="position">
        <param name="min">{-2*pi}</param>
        <param name="max">{2*pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}joint2">
      <command_interface name="position">
        <param name="min">{-2*pi}</param>
        <param name="max">{2*pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}joint3">
      <command_interface name="position">
        <param name="min">{-2*pi}</param>
        <param name="max">{2*pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
