    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <sensor name="${prefix}link6_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <contact>
        <collision>${prefix}link6_fixed_joint_lump__${prefix}link6_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="${prefix}link6_bumper">
        <ros>
