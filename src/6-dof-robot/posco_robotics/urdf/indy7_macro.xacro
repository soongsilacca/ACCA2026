<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="indy7" params="prefix">

  <material name="indy_white">
    <color rgba="0.8941176470588236 0.8941176470588236 0.8941176470588236 1.0"/>
  </material>
  
  <link name="${prefix}link0">
