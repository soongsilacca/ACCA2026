      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find posco_robotics)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="${prefix}link0">
    <material>Gazebo/White</material>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="${prefix}link1">
    <material>Gazebo/White</material>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <sensor name="${prefix}link1_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <contact>
        <collision>${prefix}link1_fixed_joint_lump__${prefix}link1_collision</collision>
      </contact>
      <plugin filename="libgazebo_ros_bumper.so" name="${prefix}link1_bumper">
        <ros>
          <namespace>indy7</namespace>
          <remapping>bumper_states:=/${prefix}contact_sensor</remapping>
        </ros>
        <frame_name>${prefix}link1</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="${prefix}link2">
