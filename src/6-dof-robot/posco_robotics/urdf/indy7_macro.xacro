    <inertial>
      <mass value="1.6703078"/>
      <origin rpy="0 0 0" xyz="0.00131966                             -2.18e-06                             0.03212832"/>
      <inertia ixx="0.00661309" ixy="1.83e-06" ixz="2.695e-05" iyy="0.00644765" iyz="-2.7e-07" izz="0.0079209"/>
    </inertial>
  </link>
