<launch>
  <!-- ════════════════════════════════════════════════════════════════
       MORAI Traffic Light Controller GUI Launch File
       ════════════════════════════════════════════════════════════════ -->

  <!-- 기본 UDP 포트 및 IP 설정 -->
  <arg name="ip" default="127.0.0.1" />
  <arg name="port" default="7607" />
  <arg name="map_dir" default="$(find hdmap_loader)/scripts" />

  <node name="traffic_light_controller" pkg="morai_udp_bridge" type="traffic_light_controller_node.py" output="screen">
    <param name="ip" value="$(arg ip)" />
    <param name="port" value="$(arg port)" />
    <param name="map_dir" value="$(arg map_dir)" />
  </node>
</launch>
