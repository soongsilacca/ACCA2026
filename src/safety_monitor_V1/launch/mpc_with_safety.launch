<launch>
  <!-- Full driving stack (sensors, localization, MGeo route, MPC, ctrl
       sender) plus the Safety Monitor collision E-STOP.

       The patched mpc_node.py subscribes to /safety/estop_trigger and
       brakes while it is true, so the safety layer needs no separate gate
       on the control path. -->

  <!-- ===================== driving stack args ======================= -->
  <arg name="path_topic" default="/global_path" />
  <arg name="controller_mode" default="mpc" />
  <arg name="path_start_index" default="0" />
  <arg name="ai_path_timeout" default="1.5" />
  <arg name="target_velocity_topic" default="/mgeo_target_velocity" />
  <arg name="mode_score_topic" default="/multimodal_learning/mode_scores" />
  <arg name="stop_full_brake_threshold" default="0.8" />
  <arg name="stop_latch_threshold" default="0.5" />
  <arg name="stop_release_drive_threshold" default="0.8" />
  <arg name="stop_release_hold_sec" default="2.0" />
  <arg name="mode_score_timeout" default="1.5" />
  <arg name="stanley_max_lateral_acceleration_mps2" default="3.0" />
  <arg name="stanley_curve_preview_m" default="10.0" />
  <arg name="stanley_curve_min_speed_mps" default="1.0" />
  <arg name="launch_stack" default="true" />
  <arg name="use_sim_time" default="false" />
  <arg name="global_path_csv"
       default="$(env HOME)/acca_ws/global_path/global_path.csv" />

  <!-- ====================== safety args ============================= -->
  <arg name="estop_config"
       default="$(find safety_monitor)/config/collision_estop.yaml" />
  <!-- >0 : MPC treats this many seconds of trigger silence as E-STOP.
       Keep 0 while testing the MPC alone; set 0.5 once this launch is the
       standard way to drive. -->
  <arg name="safety_estop_timeout" default="0.0" />

  <!-- =================== existing driving stack ===================== -->
  <include file="$(find control)/launch/control_mpc_with_collision.launch">
    <arg name="path_topic" value="$(arg path_topic)" />
    <arg name="controller_mode" value="$(arg controller_mode)" />
    <arg name="path_start_index" value="$(arg path_start_index)" />
    <arg name="ai_path_timeout" value="$(arg ai_path_timeout)" />
    <arg name="target_velocity_topic" value="$(arg target_velocity_topic)" />
    <arg name="mode_score_topic" value="$(arg mode_score_topic)" />
    <arg name="stop_full_brake_threshold"
         value="$(arg stop_full_brake_threshold)" />
    <arg name="stop_latch_threshold" value="$(arg stop_latch_threshold)" />
    <arg name="stop_release_drive_threshold"
         value="$(arg stop_release_drive_threshold)" />
    <arg name="stop_release_hold_sec" value="$(arg stop_release_hold_sec)" />
    <arg name="mode_score_timeout" value="$(arg mode_score_timeout)" />
    <arg name="stanley_max_lateral_acceleration_mps2"
         value="$(arg stanley_max_lateral_acceleration_mps2)" />
    <arg name="stanley_curve_preview_m"
         value="$(arg stanley_curve_preview_m)" />
    <arg name="stanley_curve_min_speed_mps"
         value="$(arg stanley_curve_min_speed_mps)" />
    <arg name="launch_stack" value="$(arg launch_stack)" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="global_path_csv" value="$(arg global_path_csv)" />
  </include>

  <!-- MPC picks up the watchdog setting; the node itself is started by the
       include above, so only the parameter is set here. -->
  <param name="/mpc_trajectory_follower/safety_estop_timeout"
         value="$(arg safety_estop_timeout)" />

  <!-- ======================= safety monitor ========================= -->
  <node pkg="safety_monitor" type="collision_estop_node.py"
        name="collision_estop" output="screen" respawn="true">
    <rosparam file="$(arg estop_config)" command="load" />
  </node>
</launch>
