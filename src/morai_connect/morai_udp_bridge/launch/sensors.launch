<launch>
  <!-- ══════════════════════════════════════════════
       MORAI UDP Bridge — Sensor nodes
       GPS / IMU / Camera (front, left, right)
       ══════════════════════════════════════════════ -->

  <arg name="gps_port" default="9090" />
  <arg name="gps_topic" default="/gps" />

  <arg name="imu_port" default="1112" />
  <arg name="imu_topic" default="/imu" />

  <arg name="cam_front_port" default="9291" />
  <arg name="cam_front_topic" default="/camera/front/image_raw" />

  <arg name="cam_left_port" default="9293" />
  <arg name="cam_left_topic" default="/camera/left/image_raw" />

  <arg name="cam_right_port" default="9295" />
  <arg name="cam_right_topic" default="/camera/right/image_raw" />

  <!-- GPS  UDP 9090 → /gps -->
  <node name="morai_gps"
        pkg="morai_udp_bridge"
        type="gps_publisher_node.py"
        output="screen">
    <param name="port" value="$(arg gps_port)" />
    <param name="topic" value="$(arg gps_topic)" />
  </node>

  <!-- IMU  UDP 1112 → /imu -->
  <node name="morai_imu"
        pkg="morai_udp_bridge"
        type="imu_publisher_node.py"
        output="screen">
    <param name="port" value="$(arg imu_port)" />
    <param name="topic" value="$(arg imu_topic)" />
  </node>

  <!-- Camera Front  UDP 9291 → /camera/front/image_raw -->
  <node name="morai_camera_front"
        pkg="morai_udp_bridge"
        type="camera_front_publisher_node.py"
        output="screen">
    <param name="port" value="$(arg cam_front_port)" />
    <param name="topic" value="$(arg cam_front_topic)" />
  </node>

  <!-- Camera Left   UDP 9293 → /camera/left/image_raw -->
  <node name="morai_camera_left"
        pkg="morai_udp_bridge"
        type="camera_left_publisher_node.py"
        output="screen">
    <param name="port" value="$(arg cam_left_port)" />
    <param name="topic" value="$(arg cam_left_topic)" />
  </node>

  <!-- Camera Right  UDP 9295 → /camera/right/image_raw -->
  <node name="morai_camera_right"
        pkg="morai_udp_bridge"
        type="camera_right_publisher_node.py"
        output="screen">
    <param name="port" value="$(arg cam_right_port)" />
    <param name="topic" value="$(arg cam_right_topic)" />
  </node>

</launch>
