Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: V17 Layers
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 117
  - Class: rviz/Selection
    Name: Inspector
  - Class: rviz/Time
    Name: Timing
    SyncMode: 0
    SyncSource: Front Camera
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Group
      Displays:
        - Alpha: 0.2199999988079071
          Cell Size: 1
          Class: rviz/Grid
          Color: 45; 67; 88
          Enabled: true
          Line Style:
            Line Width: 0.029999999329447746
            Value: Lines
          Name: Metric Grid 1m
          Normal Cell Count: 0
          Offset:
            X: 0
            Y: 0
            Z: 0
          Plane: XY
          Plane Cell Count: 80
          Reference Frame: base_link
          Value: true
        - Alpha: 0.3499999940395355
          Class: rviz/Axes
          Enabled: true
          Length: 1
          Name: Ego Axes
          Radius: 0.10000000149011612
          Reference Frame: base_link
          Show Trail: false
          Value: true
        - Class: rviz/TF
          Enabled: true
          Filter (blacklist): ""
          Filter (whitelist): ""
          Frame Timeout: 15
          Frames:
            All Enabled: true
            base_link:
              Value: true
            camera_front:
              Value: true
            camera_left:
              Value: true
            camera_right:
              Value: true
            gps:
              Value: true
            imu:
              Value: true
            map:
              Value: true
            odom:
              Value: true
            velodyne:
              Value: true
          Marker Alpha: 1
          Marker Scale: 0.44999998807907104
          Name: Sensor TF
          Show Arrows: true
          Show Axes: true
          Show Names: true
          Tree:
            map:
              odom:
                base_link:
                  camera_front:
                    {}
                  camera_left:
                    {}
                  camera_right:
                    {}
                  gps:
                    {}
                  imu:
                    {}
                  velodyne:
                    {}
          Update Interval: 0
          Value: true
      Enabled: true
      Name: Scene
    - Class: rviz/Group
      Displays:
        - Alpha: 0.5799999833106995
          Buffer Length: 1
          Class: rviz/Path
          Color: 60; 255; 115
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.07500000298023224
          Name: MGeo Local Route
          Offset:
            X: 0
            Y: 0
            Z: 0.029999999329447746
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /local_route
          Unreliable: false
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz/Path
          Color: 0; 235; 255
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.18000000715255737
          Name: MPC MGeo Path
          Offset:
            X: 0
            Y: 0
            Z: 0.18000000715255737
          Pose Color: 255; 85; 255
          Pose Style: None
          Queue Size: 10
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /local_route
          Unreliable: false
          Value: true
        - Class: rviz/MarkerArray
          Enabled: true
          Marker Topic: /multimodal_learning/predicted_path_markers
          Name: Teacher Decision Surface and HUD
          Namespaces:
            pedestrian_prediction: true
            signal_target: true
            teacher_decision: true
            teacher_path_surface: true
          Queue Size: 20
          Value: true
      Enabled: true
      Name: V17 Planning
    - Class: rviz/Group
      Displays:
        - Alpha: 0.9200000166893005
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -2
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 35; 235
          Min Color: 0; 225; 255
          Name: Filtered LiDAR
          Position Transformer: XYZ
          Queue Size: 6
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.04500000178813934
          Style: Flat Squares
          Topic: /velodyne_points_filtered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Angle Tolerance: 0.10000000149011612
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.30000001192092896
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 80
          Name: Ego Pose Trail
          Position Tolerance: 0.07999999821186066
          Queue Size: 10
          Shape:
            Alpha: 0.800000011920929
            Axes Length: 0.6499999761581421
            Axes Radius: 0.04500000178813934
            Color: 255; 215; 30
            Head Length: 0.25
            Head Radius: 0.10000000149011612
            Shaft Length: 0.6000000238418579
            Shaft Radius: 0.04500000178813934
            Value: Arrow
          Topic: /localization/kinematic_state
          Unreliable: false
          Value: true
      Enabled: true
      Name: Perception
    - Class: rviz/Group
      Displays:
        - Class: rviz/Image
          Enabled: false
          Image Topic: /camera/front/image
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Front Camera
          Normalize Range: true
          Queue Size: 2
          Transport Hint: compressed
          Unreliable: false
          Value: false
        - Class: rviz/Image
          Enabled: true
          Image Topic: /camera/left/image_raw
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Left Camera
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
        - Class: rviz/Image
          Enabled: true
          Image Topic: /camera/right/image_raw
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Right Camera
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
      Enabled: true
      Name: Cameras
  Enabled: true
  Global Options:
