<launch>
  <arg name="launch_sensors" default="true" />
  <arg name="launch_controller" default="true" />
  <arg name="rviz" default="true" />
  <arg name="checkpoint_path"
       default="$(find multimodal_learning)/model_artifacts/transfuser_morai/best.pt" />
  <arg name="global_path_csv" default="$(env HOME)/acca_ws/global_path/global_path.csv" />
  <arg name="rviz_config" default="$(find multimodal_learning)/config/inference.rviz" />

  <group if="$(arg launch_sensors)">
    <include file="$(find multimodal_learning)/launch/multimodal_sensors.launch">
      <arg name="global_path_csv" value="$(arg global_path_csv)" />
      <arg name="enable_ctrl_sender" value="true" />
    </include>
  </group>

  <node pkg="multimodal_learning" type="transfuser_inference_node.py"
        name="multimodal_inference" output="screen" required="true">
    <param name="checkpoint_path" value="$(arg checkpoint_path)" />
    <param name="model_inference_period" value="0.3" />
    <param name="prediction_timeout" value="1.5" />
    <param name="stop_speed_mps" value="0.5" />
    <param name="mgeo_target_velocity_topic" value="/mgeo_target_velocity" />
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz"
        name="multimodal_inference_rviz" args="-d $(arg rviz_config)" output="screen" />

  <group if="$(arg launch_controller)">
    <include file="$(find control)/launch/control_mpc_with_weight.launch">
      <arg name="controller_mode" value="mpc" />
      <arg name="path_topic" value="/multimodal_learning/predicted_path" />
      <arg name="path_start_index" value="0" />
      <arg name="target_velocity_topic" value="/target_velocity" />
      <arg name="mode_score_topic" value="/multimodal_learning/mode_scores" />
      <arg name="stop_full_brake_threshold" value="0.8" />
      <arg name="stop_latch_threshold" value="0.5" />
      <arg name="stop_release_drive_threshold" value="0.8" />
      <arg name="stop_release_hold_sec" value="0.0" />
      <arg name="launch_stack" value="false" />
    </include>
  </group>
</launch>
