Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: base_link
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 150; 150; 150
      Color Transformer: FlatColor
      Decay Time: 0.15
      Enabled: true
      Name: Raw rear LiDAR (diagnostic)
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic: /rear_lidar/points_raw
      Use Fixed Frame: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 80; 220; 255
      Color Transformer: Intensity
      Decay Time: 0.25
      Enabled: true
      Name: Obstacles (road/walls removed)
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.06
      Style: Points
      Topic: /rear_lidar/obstacles
      Use Fixed Frame: true
    - Alpha: 0.30
      Class: rviz/PointCloud2
      Color: 255; 220; 40
      Color Transformer: FlatColor
      Enabled: true
      Name: Debug Cropped
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 2
      Style: Points
      Topic: /rear_lidar/debug/cropped
    - Alpha: 0.25
      Class: rviz/PointCloud2
      Color: 100; 100; 100
      Color Transformer: FlatColor
      Enabled: true
      Name: Debug Ground
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 2
      Style: Points
      Topic: /rear_lidar/debug/ground
    - Alpha: 0.35
      Class: rviz/PointCloud2
      Color: 180; 80; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: Debug Walls
      Position Transformer: XYZ
      Queue Size: 2
      Size (Pixels): 2
      Style: Points
      Topic: /rear_lidar/debug/walls
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /rear_lidar/markers
      Name: Tracks and predictions
      Namespaces:
        rear_lidar_boxes: true
        rear_lidar_labels: true
        rear_lidar_predictions: true
      Queue Size: 10
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Default Light: true
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Angle: -1.5708
      Class: rviz/TopDownOrtho
      Name: Rear top view
      Scale: 25
      Target Frame: base_link
      X: -25
      Y: 0
Window Geometry:
  Height: 900
  Width: 1440
